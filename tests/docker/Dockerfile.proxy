FROM nginx:stable-alpine@sha256:970364228b1e4f932abc22d321932816782cca8a20b85a77552a7cfe9acfb3b5

ENV NGINX_ENVSUBST_FILTER=FACTGRID_

COPY deploy/nginx/factgrid.conf.template /etc/nginx/templates/default.conf.template
COPY deploy/nginx/factgrid-proxy-headers.conf /etc/nginx/factgrid-proxy-headers.conf

EXPOSE 443
