FROM node:22-bookworm-slim

WORKDIR /fixture
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl \
  && rm -rf /var/lib/apt/lists/*

COPY tests/docker/provider.mjs /fixture/provider.mjs
COPY tests/fixtures/factgrid/*.json /fixture/fixtures/

EXPOSE 443 8443
HEALTHCHECK --interval=2s --timeout=2s --start-period=2s --retries=20 \
  CMD ["node", "-e", "require('https').get({hostname:'127.0.0.1',port:443,path:'/health',rejectUnauthorized:false},r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"]
CMD ["sh", "-c", "umask 077 && openssl req -x509 -newkey rsa:2048 -sha256 -days 2 -nodes -keyout /fixture/server.key -out /fixture/server.crt -subj '/CN=database.factgrid.de' -addext 'subjectAltName=DNS:database.factgrid.de,DNS:app.factgrid.test' -addext 'basicConstraints=critical,CA:TRUE' -addext 'keyUsage=critical,digitalSignature,keyEncipherment,keyCertSign' >/dev/null 2>&1 && cp /fixture/server.crt /shared/provider-ca.pem && chmod 0444 /shared/provider-ca.pem && exec node /fixture/provider.mjs"]
