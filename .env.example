# Public FactGrid endpoints are fixed in server-side application code and are
# intentionally not configurable to arbitrary hosts.

# OAuth remains unavailable until the selected protocol and session values are configured.
# In production use the exact external HTTPS callback registered at FactGrid;
# the TLS proxy must overwrite X-Forwarded-Host and X-Forwarded-Proto.
# Set proxy trust only when requests can reach the application solely through
# the checked-in proxy boundary, which also overwrites X-FactGrid-Client-IP.
# Register a non-owner-only OAuth 1.0a consumer; do not enable callback prefixes.
FACTGRID_OAUTH_VERSION=1.0a
FACTGRID_OAUTH_CONSUMER_KEY=
FACTGRID_OAUTH_CONSUMER_SECRET=

# Legacy OAuth 2 deployments can explicitly select FACTGRID_OAUTH_VERSION=2.0.
# Omitting the version preserves existing OAuth 2 configuration compatibility.
FACTGRID_OAUTH_CLIENT_ID=
FACTGRID_OAUTH_CLIENT_SECRET=
FACTGRID_OAUTH_CALLBACK_URL=http://127.0.0.1:3000/api/auth/callback
SESSION_SECRET=
FACTGRID_SESSION_DB_PATH=.data/factgrid-sessions.sqlite
FACTGRID_TRUST_PROXY=false

# Contributor policy defaults to restricted so existing deployments do not
# silently widen access. "restricted" requires both allowlists below;
# "authenticated" permits ordinary signed-in FactGrid users whose current
# account rights and OAuth grants pass the server-side checks.
FACTGRID_CONTRIBUTOR_POLICY=restricted

# Comma-separated exact FactGrid usernames approved in restricted mode.
# Empty denies every write while FACTGRID_CONTRIBUTOR_POLICY=restricted.
FACTGRID_ALLOWED_EDITORS=

# Comma-separated exact QID|Document title pairs used in restricted mode.
# Empty denies transcript writes and creation while restricted. Metadata edits
# are still limited to existing catalogue tablets and the approved usernames.
# Example: Q1089841|D-Q1089841
FACTGRID_ALLOWED_EDIT_TARGETS=

# Exact public origin used for callback and CSRF Origin validation.
APP_ORIGIN=http://127.0.0.1:3000

# Editing is additionally gated by this explicit switch. Keep false until an
# OAuth consumer, approved editor policy, and designated test record exist.
FACTGRID_EDITING_ENABLED=false

# Optional exact QID/title pair for a designated, authorized live write test.
FACTGRID_WRITE_TEST_QID=
FACTGRID_WRITE_TEST_TITLE=
