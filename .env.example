# Public FactGrid endpoints are fixed in server-side application code and are
# intentionally not configurable to arbitrary hosts.

# OAuth 2 remains unavailable unless every value in this block is configured.
FACTGRID_OAUTH_CLIENT_ID=
FACTGRID_OAUTH_CLIENT_SECRET=
FACTGRID_OAUTH_CALLBACK_URL=http://127.0.0.1:3000/api/auth/callback
SESSION_SECRET=
FACTGRID_SESSION_DB_PATH=.data/factgrid-sessions.sqlite

# Comma-separated exact FactGrid usernames approved for this interface.
# Empty means every transliteration write is denied, even after sign-in.
FACTGRID_ALLOWED_EDITORS=

# Comma-separated exact QID|Document title pairs. Empty denies every write,
# including format-compatible D pages with one plain Transcript-section poem.
# Example: Q1089841|D-Q1089841
FACTGRID_ALLOWED_EDIT_TARGETS=

# Exact public origin used for callback and CSRF Origin validation.
APP_ORIGIN=http://127.0.0.1:3000

# Editing is additionally gated by this explicit switch. Keep false until an
# OAuth consumer, approved editor policy, and designated test record exist.
FACTGRID_EDITING_ENABLED=false

# Optional exact QID/title pair for a designated, authorized live write test.
FACTGRID_WRITE_TEST_QID=
FACTGRID_WRITE_TEST_TITLE=
